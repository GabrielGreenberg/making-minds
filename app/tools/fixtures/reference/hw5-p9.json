{
  "question": {
    "id": 9,
    "label": "Problem 9",
    "statement": "Design a Turing machine that adds two binary numerals, reusing your add-one and subtract-one machines. The tape starts with the numeral of y between asterisk markers on the left and the numeral of x between asterisk markers on the right, with the head on the rightmost marker. The machine must transfer the value of x into the y block one unit at a time, then erase everything except a single well-formed block containing the binary numeral of x + y — clean up so that exactly one pair of markers remains on the tape.",
    "buildMode": "TM",
    "representation": "binary",
    "cc_spec": {
