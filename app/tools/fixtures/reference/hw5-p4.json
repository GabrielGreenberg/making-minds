      "inputs": [
        {
          "name": "y",
          "width": 8
        },
        {
          "name": "x",
          "width": 8
        }
      ],
      "outputs": [
        {
          "name": "out",
          "width": 16,
          "formula": "x + y"
        }
      ]
    },
